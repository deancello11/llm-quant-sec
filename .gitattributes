# Keep Unix line endings for anything that runs on Linux. A Windows checkout would otherwise turn shell scripts into
# CRLF files, and bash then fails with confusing "bad interpreter" or "invalid option" errors.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.png binary
